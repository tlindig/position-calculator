{
  "name": "@tlindig/position-calculator",
  "version": "2.0.0",
  "description": "Calculate the position of an element relative to another element or event. It has also functionality to handle collision within the viewport of a given container. It does not manipulate CSS or DOM, it only calculates values. It is a basic technology to support implementation of tooltips, popups, popovers, scrollspies and many more.",
  "type": "module",
  "module": "./dist/position-calculator.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/position-calculator.js"
    },
    "./iife": "./dist/position-calculator.iife.min.js",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/position-calculator.iife.min.js"
  ],
  "files": [
    "dist",
    "types"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node test/run.js all --jquery=0",
    "test:dist": "node test/run.js all --impl=dist/position-calculator.js --jquery=0 && node test/run.js all --impl=dist/position-calculator.iife.min.js --format=iife --jquery=0 && node test/run.js dev --impl=dist/position-calculator.iife.min.js --format=iife --jquery=1",
    "test:jquery": "node test/run.js dev --impl=src/iife.js --jquery=1",
    "test:node": "node test/node-import.js",
    "test:cross-browser": "node test/cross-browser.js",
    "test:types": "tsc --noEmit -p test/types/tsconfig.json",
    "test:consumer": "node scripts/check-consumer.js",
    "build": "node scripts/build.js",
    "docs:build": "node scripts/build-docs.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tlindig/position-calculator.git"
  },
  "keywords": [
    "position",
    "boundary",
    "placement",
    "calculate",
    "reference",
    "target",
    "viewport",
    "collision",
    "offset",
    "relative",
    "translate",
    "sticky",
    "flip",
    "fit",
    "ui"
  ],
  "author": "Tobias Lindig <dev@tlindig.de>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tlindig/position-calculator/issues"
  },
  "homepage": "https://github.com/tlindig/position-calculator#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "~0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2"
  }
}
